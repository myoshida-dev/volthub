# Conexão com o PostgreSQL (troque SUA_SENHA pela senha do usuário postgres)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/volthub?schema=public"

# Segredo usado para assinar a sessão. Gere um com:  npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Necessário ao rodar com `npm run build && npm start` fora da Vercel
AUTH_TRUST_HOST=true
